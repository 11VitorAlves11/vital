# ---- Base de dados ----
POSTGRES_USER=vital
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vital
DATABASE_URL=postgresql+asyncpg://vital:change-me@db:5432/vital

# ---- Autenticação ----
# oidc: qualquer provider OIDC (Authentik, Keycloak, Pocket ID, Google)
# local: email + password, para quem não tem provider OIDC
AUTH_MODE=oidc
OIDC_ISSUER=https://auth.example.com/application/o/vital/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---- Extração LLM (v1.1) ----
# Qualquer modelo suportado pelo LiteLLM, no formato "provider/modelo".
# Vazio = extração desativada.
LLM_MODEL=
LLM_API_KEY=
# Para um Ollama local: http://10.0.0.10:11434
LLM_BASE_URL=

# ---- Armazenamento ----
# PDFs originais e fotos de progresso
STORAGE_PATH=/storage

# ---- Aplicação ----
ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost:5173"]
