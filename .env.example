# ---- Base de dados ----
POSTGRES_USER=vital
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vital
DATABASE_URL=postgresql+asyncpg://vital:change-me@db:5432/vital

# ---- Autenticação ----
# oidc: qualquer provider OIDC (Authentik, Keycloak, Pocket ID, Google)
# local: email + password, para quem não tem provider OIDC
AUTH_MODE=oidc
OIDC_ISSUER=https://auth.example.com/application/o/vital/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Só se um proxy reescrever esquema ou host: tem de bater certo com o redirect
# URI registado no provider.
OIDC_REDIRECT_URI=

# Assina o cookie de sessão. Obrigatório com ENVIRONMENT=prod; trocá-lo termina
# todas as sessões. Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Para onde o browser volta depois do OIDC.
FRONTEND_URL=http://localhost:5173

# ---- Extração LLM (v1.1) ----
# Qualquer modelo suportado pelo LiteLLM, no formato "provider/modelo".
# Vazio = extração desativada (a app continua a funcionar, com entrada manual).
# Um PDF digitalizado vai para o modelo como imagens, por isso um modelo sem
# visão só serve para PDFs com camada de texto.
LLM_MODEL=
LLM_API_KEY=
# Para um Ollama local: http://10.0.0.10:11434
LLM_BASE_URL=
LLM_TIMEOUT=180

# Limites de um upload. Cada página digitalizada é uma imagem enviada ao modelo:
# são estes números que limitam o que uma análise pode custar, em tokens e em
# memória.
EXTRACTION_MAX_PAGES=20
# Abaixo destes caracteres por página, o PDF é tratado como digitalização.
EXTRACTION_TEXT_THRESHOLD=200
UPLOAD_MAX_BYTES=20971520

# ---- Armazenamento ----
# PDFs originais e fotos de progresso
STORAGE_PATH=/storage

# ---- Aplicação ----
ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost:5173"]
